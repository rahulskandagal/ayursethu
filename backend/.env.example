DATABASE_URL="postgresql://ayursethu:ayursethu@localhost:5432/ayursethu?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Optional: enables real AyurBot answers via Claude. Without it, AyurBot
# falls back to local keyword retrieval over the platform's own database.
ANTHROPIC_API_KEY=""

# Optional: where uploaded files (pharmacy documents, prescriptions, etc.)
# are written on local disk. Defaults to ./uploads under the backend's cwd.
UPLOADS_DIR=""
